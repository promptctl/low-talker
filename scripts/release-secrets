#!/usr/bin/env bash
# Checks the release credentials and sets them as this repository's secrets, which
# .github/workflows/release.yml reads to sign and notarize a tag's packages.
#
#   DEVELOPER_ID_P12_PASSWORD=<password> NOTARY_PASSWORD=<app-specific password> scripts/release-secrets <identities.p12> <apple id>
#
# The .p12 holds both Developer ID identities, Application and Installer, exported together
# with the password given. The Apple ID is a member of the Developer ID team, and the
# app-specific password is one made for it at account.apple.com: the same pair a Mac's own
# notarytool profile is stored from.
#
# Every credential is proved before any secret is set, so the workflow does not learn of a
# wrong one twenty minutes into a release.
set -euo pipefail

usage="usage: DEVELOPER_ID_P12_PASSWORD=<password> NOTARY_PASSWORD=<app-specific password> scripts/release-secrets <identities.p12> <apple id>"
p12=${1:?$usage}
apple_id=${2:?$usage}
password=${DEVELOPER_ID_P12_PASSWORD:?$usage}
notary_password=${NOTARY_PASSWORD:?$usage}
source "$(dirname "$0")/developer-id"

fail() {
  echo "release-secrets: $1" >&2
  exit 1
}

# Imported into a keychain of its own, which is what the workflow does with it, and deleted
# after, which also takes it off the search list.
scratch=$(mktemp -d "${TMPDIR:-/tmp}/lowtalker-secrets.XXXXXX")
keychain="$scratch/check.keychain-db"
trap 'security delete-keychain "$keychain" 2>/dev/null; rm -rf "$scratch"' EXIT
security create-keychain -p check "$keychain"
security import "$developer_id_ca" -k "$keychain" >/dev/null
security import "$p12" -k "$keychain" -P "$password" >/dev/null \
  || fail "$p12 does not open with DEVELOPER_ID_P12_PASSWORD"
identities=$(security find-identity -v -p basic "$keychain")
# Valid is not enough: macOS 26 carries Apple's earlier Developer ID intermediate, so a
# certificate issued under it passes find-identity, though a release chains through G2.
authority=$(openssl x509 -inform der -in "$developer_id_ca" -noout -subject)
authority=${authority#subject=}
for kind in Application Installer; do
  name="Developer ID $kind: $developer_id"
  grep -qF "\"$name\"" <<<"$identities" \
    || fail "$p12 holds no valid $name identity; it holds: $identities"
  issuer=$(security find-certificate -c "$name" -p "$keychain" | openssl x509 -noout -issuer)
  issuer=${issuer#issuer=}
  [ "$issuer" = "$authority" ] \
    || fail "$p12's $name certificate is issued by $issuer, not $authority"
done

xcrun notarytool history --apple-id "$apple_id" --team-id "$developer_team" --password "$notary_password" >/dev/null \
  || fail "notarytool could not read the notary history as $apple_id with NOTARY_PASSWORD for team $developer_team; its own error is above"

# macOS's base64 by path: another one ahead of it on PATH takes no -i. Encoded before any
# secret is set, so an encoder that fails sets none.
encoded=$(/usr/bin/base64 -i "$p12")

# The script's own repository, not the one the shell happens to be in.
repo=$(cd "$(dirname "$0")" && gh repo view --json nameWithOwner --jq .nameWithOwner)
gh secret set --repo "$repo" DEVELOPER_ID_P12 <<<"$encoded"
gh secret set --repo "$repo" DEVELOPER_ID_P12_PASSWORD <<<"$password"
gh secret set --repo "$repo" NOTARY_APPLE_ID <<<"$apple_id"
gh secret set --repo "$repo" NOTARY_PASSWORD <<<"$notary_password"
