# The body of the package's postinstall. scripts/make-pkg writes the lines above this one:
# the names of what it acts on, from the bundles it packed (input_method_name,
# input_method_executable, app, app_executable and family), then scripts/pkg/functions. It
# runs as root once the payload stands, and everything it says goes to /var/log/install.log.
#
# The package has just replaced the app and its input method on disk. The preinstall has
# already stopped the app, which an app from before the package needed, since it copied its own
# input method into the home folder of whoever ran it and would copy it back. What still runs
# is the code that stood there before, so this retires it: the app and input method of an
# installation from before LowTalker was one app; then those copies, which the text input
# system would go on launching; then,
# for each person logged in, the new bundles are registered and the input methods whose
# bundles are gone are switched off; then every person's input source caches, which predate
# the new bundles; then every input method process, which the text input system relaunches
# from the new bundle on the next request for one (measured 84 ms after a kill). Last, the app is started again for each person it was running for.
set -euo pipefail
# Bytewise, the order make-pkg sorted the payload list in, for every sort and comm below.
export LC_ALL=C

# Runs a command as this uid, inside that person's login session.
as_user() { launchctl asuser "$1" sudo -u "#$1" "${@:2}"; }
# The bundle identifier of the bundle at this path; fails for a bundle with none readable.
identifier() { /usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$1/Contents/Info.plist" 2>/dev/null; }

# Written over in place (scripts/make-pkg says why), so a file an older build had and this
# one does not is still there. Each bundle is cut back to the paths the package wrote, listed
# in the payload file beside this script, and then held to its seal, which every grant and
# the text input system check: one that still does not verify is refused here, where the
# installer shows it, rather than at the next launch. Each is given to root as the payload
# lists it, since the installer keeps the owner of a directory already on disk, and a bundle
# a person once wrote would stay theirs to change (measured 2026-09-29).
payload="$(dirname "$0")/payload"
for bundle in "$app" "/Library/Input Methods/$input_method_name"; do
  chown -R root:wheel "$bundle"
  removed=0
  while IFS= read -r path; do
    rm -rf "${path#.}"
    removed=$((removed + 1))
  done < <(comm -23 <(cd / && find ".$bundle" | sort) "$payload")
  say "removed $removed paths from $bundle that this package does not carry"
  codesign --verify --deep --strict "$bundle" || { say "$bundle does not verify; remove it and install again"; exit 1; }
done

# A step that fails for one person is said and fails the install at the end, once every other
# step has run, so no one else is left with the app stopped and the old input method running.
failed=0

# The apps the preinstall stopped, as "pid uid" lines.
apps=$(<"$(dirname "$0")/stopped")

# LowTalker was once installed as two apps side by side, the second under identifiers of its
# own, "dev" after the family and "dev.inputmethod.dictation" (low-build-41v). Whatever of
# that installation stands in the two folders this package writes to is stopped and removed,
# so one app and one input method remain, and the switched-on lists below drop the entry of
# the input method that went. A person its app was running for gets this one started instead.
for bundle in /Applications/*.app "/Library/Input Methods"/*.app; do
  [ "$bundle" != "$app" ] && [ "$bundle" != "/Library/Input Methods/$input_method_name" ] || continue
  # A bundle with no readable identifier is someone else's, and so is any identifier that
  # is not one of the two the second installation had: the family holds other products' bundles.
  id=$(identifier "$bundle") || continue
  case "$id" in "${family}dev" | "${family}dev.inputmethod.dictation") ;; *) continue ;; esac
  # A bundle with no executable name has no process to stop, and is removed all the same.
  older=
  if executable=$(/usr/libexec/PlistBuddy -c "Print :CFBundleExecutable" "$bundle/Contents/Info.plist" 2>/dev/null); then
    older=$(running "$executable")
    stop $(cut -d ' ' -f 1 <<<"$older") || failed=1
  else
    say "$bundle names no executable, so no process of it was looked for"
  fi
  case "$bundle" in /Applications/*) apps+=$'\n'"$older" ;; esac
  rm -rf "$bundle"
  say "removed $bundle ($id), an installation from before LowTalker was one app, which had $(lines "$older") running"
done

# No build installs into a home folder any more, so every LowTalker input method there is one
# an older app put there, whichever installation or identifier it carried. Older builds linked
# rather than copied, so a link whose bundle is gone is one of them too, known by its name.
for home in /Users/*; do
  for bundle in "$home/Library/Input Methods"/*.app; do
    if [ -L "$bundle" ] && [ ! -e "$bundle" ]; then
      case "$(basename "$bundle")" in LowTalker*) ;; *) continue ;; esac
    else
      [ -e "$bundle" ] || continue
      # A bundle with no readable identifier is someone else's, not a copy of this one.
      id=$(identifier "$bundle") || continue
      [ "${id#"$family"}" != "$id" ] || continue
    fi
    rm -rf "$bundle"
    say "removed $bundle, which an older build of the app put there"
  done
done

# Each person with a login session now, by the uid their loginwindow runs as (root's is the
# login screen's, and no one's), gets the two bundles registered with LaunchServices and their
# switched-on list cut back.
#
# Registered by name, as the installer does for a bundle component and does not for the plain
# files make-pkg writes: nothing watches /Library/Input Methods, and the input method is
# launched by its identifier. Measured on studious 2026-09-29: without this the app had a
# record and the input method none, and the app's own TISRegisterInputSource makes none.
#
# A LowTalker input method switched on whose bundle is installed nowhere is a leftover of an
# installation that is gone, and the text input system keeps its entry. The list is cut back
# to the LowTalker input methods /Library/Input Methods holds, through the person's own
# preferences daemon (measured 2026-09-29: a write there takes effect at once), and only that
# key is written, so nothing else in the domain is put back to what it was when it was read.
# Entries of other products are left as they are. After the old app and its home-folder
# copies are gone, since that app would switch its copy on again.
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
key=AppleEnabledThirdPartyInputSources
installed=$(for bundle in "/Library/Input Methods"/*.app; do identifier "$bundle" || true; done)
for uid in $(ps -axo uid=,comm= | awk '$1 != 0 && $2 ~ /\/loginwindow$/ { print $1 }' | sort -u); do
  if as_user "$uid" "$lsregister" -f "$app" "/Library/Input Methods/$input_method_name"; then
    say "registered both bundles with LaunchServices for uid $uid"
  else
    say "could not register the bundles with LaunchServices for uid $uid"; failed=1
  fi

  # A person who never switched an input method on has no such list, and nothing to cut.
  as_user "$uid" defaults read com.apple.inputsources "$key" >/dev/null 2>&1 || continue
  # Read into a file here, since the person cannot write a file root made.
  list=$(mktemp)
  as_user "$uid" defaults export com.apple.inputsources - | plutil -extract "$key" xml1 -o "$list" - ||
    { say "could not read the switched-on input methods for uid $uid"; rm -f "$list"; failed=1; continue; }
  count=0
  while /usr/libexec/PlistBuddy -c "Print :$count" "$list" >/dev/null 2>&1; do count=$((count + 1)); done
  dropped=0
  # From the end, so a deletion does not move an entry not yet read.
  for ((i = count - 1; i >= 0; i--)); do
    id=$(/usr/libexec/PlistBuddy -c "Print :$i:Bundle\ ID" "$list" 2>/dev/null) || continue
    [ "${id#"$family"}" != "$id" ] || continue
    grep -qxF "$id" <<<"$installed" && continue
    /usr/libexec/PlistBuddy -c "Delete :$i" "$list"
    say "switched off $id for uid $uid: no bundle with that identifier is installed"
    dropped=$((dropped + 1))
  done
  [ "$dropped" -eq 0 ] || as_user "$uid" defaults write com.apple.inputsources "$key" "$(cat "$list")" ||
    { say "could not write the switched-on input methods for uid $uid"; failed=1; }
  rm -f "$list"
done

# Every sandboxed process reads input sources from its own cache in its person's cache folder,
# and a bundle written into an Input Methods folder invalidates none of them, while
# TISRegisterInputSource refreshes only its caller's. System Settings' Keyboard pane is one:
# measured on studious 2026-10-01, it answers the app's switch-on with "Invalid value on
# inputSourceToBeEnabled" and shows nothing until its cache is gone, when it rebuilds the list
# from disk and asks the person. So every cache goes, for every person, logged in or not, since
# the folder outlives a session, and each process rebuilds its own on its next read. After the
# bundles are registered and the switched-on lists cut back, so no rebuild predates either.
# Deleted as that person, with their rights and not root's, in a folder they own. Some
# sandbox caches in it are closed even to their owner (on u2 2026-10-15: WebKit's, Shortcuts',
# Quick Look's), and find fails on each with "Operation not permitted". Those are said and
# passed over, since their owner is who this runs as; anything else find says fails the step.
for uid in $(dscl . -list /Users UniqueID | awk '$2 >= 501 { print $2 }'); do
  if ! cache=$(sudo -u "#$uid" getconf DARWIN_USER_CACHE_DIR); then
    say "could not find the cache folder of uid $uid"; failed=1; continue
  fi
  cache=${cache%/}
  errors=$(mktemp) || { say "could not make a file for what find says for uid $uid"; failed=1; continue; }
  status=0
  caches=$(sudo -u "#$uid" find "$cache" -maxdepth 2 -type f -name 'com.apple.IntlDataCache.le*' -delete -print 2>"$errors") || status=$?
  closed='' complaints=''
  while IFS= read -r line; do
    case $line in
      "find: $cache/"*": Operation not permitted") closed+=$line$'\n' ;;
      *) complaints+=$line$'\n' ;;
    esac
  done <"$errors"
  rm -f "$errors"
  closed=${closed%$'\n'} complaints=${complaints%$'\n'}
  [ -z "$closed" ] || say "passed over $(lines "$closed") folders closed to uid $uid:"$'\n'"$closed"
  # find exits 1 for a folder it could not open, and 0 for a file -delete could not remove,
  # which it still prints and only its complaint names. So the step passes when find said
  # nothing but closed folders and exited as those alone make it.
  if [ -z "$complaints" ] && [ "$status" -eq $((${#closed} > 0)) ]; then
    say "removed $(lines "$caches") input source caches for uid $uid"
  else
    say "could not remove the input source caches for uid $uid (find exited $status)${complaints:+:$'\n'$complaints}"; failed=1
  fi
done

methods=$(running "$input_method_executable")
say "found $(lines "$methods") running $input_method_executable"
stop $(cut -d ' ' -f 1 <<<"$methods") || failed=1

for uid in $(cut -s -d ' ' -f 2 <<<"$apps" | sort -u); do
  # The files are installed whether or not this start takes, so a failed one is said and
  # the install stands: a person who logged out since the app was stopped has no session
  # to start it in.
  if as_user "$uid" /usr/bin/open "$app"; then
    say "started $app again for uid $uid"
  else
    say "could not start $app again for uid $uid; it starts when that person opens it"
  fi
done

[ "$failed" -eq 0 ] || { say "the install is in place, but a step above failed for someone"; exit 1; }
