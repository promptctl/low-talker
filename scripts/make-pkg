#!/usr/bin/env bash
# Packs an app and the input method built with it into the signed installer package a person
# installs: the app into /Applications and the input method into /Library/Input Methods.
#
#   scripts/make-pkg <path to .app> <path to input method .app> <output directory>
#     # prints <output directory>/<app name>-<offline or network>.pkg
#
# A package and not a disk image, and the package and not the app installs the input method,
# both measured under App Sandbox on 2026-09-28: every file a sandboxed app writes carries a
# quarantine it cannot remove, so the text input system refuses an input method the app copies
# into place, and an app copied out of a quarantined disk image cannot start its nested
# helper. Files an installer package writes carry no quarantine.
#
# Every package is signed with the Developer ID Installer certificate, the development one
# included: an installer signature needs an installer identity, which the self-signed
# development identity is not, and one identity for every package is one way a package is
# made. [LAW:one-type-per-behavior] The holder is scripts/developer-id's.
set -euo pipefail

usage="usage: scripts/make-pkg <path to .app> <path to input method .app> <output directory>"
app=${1:?$usage}
input_method=${2:?$usage}
out=${3:?$usage}
source "$(dirname "$0")/developer-id"
identity="Developer ID Installer: $developer_id"

fail() {
  echo "make-pkg: $1" >&2
  exit 1
}

# A bundle is a directory, so completion leaves a slash that would hide its name.
app=${app%/}
input_method=${input_method%/}
mkdir -p "$out"
out=$(cd "$out" && pwd)

codesign --verify --deep --strict "$app" || fail "$app does not verify"
codesign --verify --deep --strict "$input_method" || fail "$input_method does not verify"

plist() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist"; }
app_id=$(plist "$app" CFBundleIdentifier)
version=$(plist "$app" CFBundleShortVersionString)
input_method_id=$(plist "$input_method" CFBundleIdentifier)
# Every identifier this product has used begins with the part of this one up to its name,
# and the postinstall knows an older installation's input method by that prefix.
[[ $input_method_id == *low-talker.* ]] || fail "$input_method_id does not name low-talker, so no older input method can be told by it"
family="${input_method_id%%low-talker.*}low-talker."
# Which build this is, read off the app's signature and never taken as an argument, so the
# package's name is what the app carries.
variant=$(codesign -d --entitlements - --xml "$app" | "$(dirname "$0")/variant")
echo "make-pkg: $app is the $variant build" >&2
# The app carries no program but itself (low-builds-b4e.tvx). An incremental Xcode build never
# deletes a file an earlier build embedded, so a warm DerivedData can still hold one.
[[ ! -e $app/Contents/Helpers ]] || fail "$app carries Contents/Helpers from an earlier build; build it clean"
# Where the two land. InstalledInputMethod.systemDirectory is the app's reading of the second.
app_path="/Applications/$(basename "$app")"
input_method_path="/Library/Input Methods/$(basename "$input_method")"

staging=$(mktemp -d "${TMPDIR:-/tmp}/lowtalker-pkg.XXXXXX")
trap 'rm -rf "$staging"' EXIT
root="$staging/root"
mkdir -p "$root/Applications" "$root/Library/Input Methods" "$staging/scripts"
ditto "$app" "$root$app_path"
ditto "$input_method" "$root$input_method_path"

# Neither bundle is a bundle component: the component list is empty, so the installer writes
# both as the files they are, where they are named, whatever the Mac already holds. Every
# rule a bundle component carries is one that broke an install [LAW:one-source-of-truth]:
# - relocatable, the default, sends a bundle to wherever LaunchServices last saw one with its
#   identifier, which on a Mac that builds LowTalker is a copy in DerivedData;
# - version checked, the default, skips a bundle whose version on disk is not older, which is
#   every rebuild of one version;
# - upgraded, the default, deletes the old bundle before writing the new one. Measured on
#   studious 2026-09-29: the text input system drops an input method whose bundle disappears,
#   and one that appears again will not run in that login session;
# - updated, the one action that writes in place, skips a bundle not already on disk
#   ("Skipping update component ... because there is no version on-disk", install.log,
#   2026-09-29), so a fresh Mac got neither bundle.
# Written as files, the bundle directory stays where it is across an install (its inode is
# kept), and a file an older build had and this one does not would stay behind and break the
# bundle's seal, so the postinstall removes every path in either bundle that the payload list
# below does not name.
components="$staging/components.plist"
cat >"$components" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><array/></plist>
EOF

# The preinstall and the postinstall, each with the names the package acts on written in from
# the bundles themselves, then the functions its body calls. %q quotes each name for bash, so
# a name with a space in it is one word.
for script in preinstall postinstall; do
  {
    echo '#!/bin/bash'
    printf 'input_method_name=%q\n' "$(basename "$input_method")"
    printf 'input_method_executable=%q\n' "$(plist "$input_method" CFBundleExecutable)"
    printf 'app=%q\n' "$app_path"
    printf 'app_executable=%q\n' "$(plist "$app" CFBundleExecutable)"
    printf 'family=%q\n' "$family"
    cat "$(dirname "$0")/pkg/functions" "$(dirname "$0")/pkg/$script"
  } >"$staging/scripts/$script"
  chmod 755 "$staging/scripts/$script"
done
# Every path the package writes inside the two bundles, which is all either may hold once it
# is installed. Sorted bytewise, as the postinstall sorts what it finds, for comm.
(cd "$root" && find ".$app_path" ".$input_method_path") | LC_ALL=C sort >"$staging/scripts/payload"

component="$staging/component.pkg"
pkgbuild --quiet --root "$root" --component-plist "$components" --scripts "$staging/scripts" \
  --identifier "$app_id" --version "$version" --install-location / "$component"

pkg="$out/$(basename "$app" .app)-$variant.pkg"
rm -f "$pkg"
productbuild --quiet --package "$component" --sign "$identity" --timestamp "$pkg"

# The package as an installer will read it: signed by the identity named above, and carrying
# both bundles at the paths the postinstall and the app expect.
# Read whole before it is searched: grep -q stops reading at its match, and under pipefail
# the SIGPIPE that reaches pkgutil would fail a package that is signed.
signature=$(pkgutil --check-signature "$pkg")
grep -qF "1. $identity" <<<"$signature" || fail "$pkg is not signed by $identity"
payload=$(pkgutil --payload-files "$pkg")
for path in "$app_path" "$input_method_path"; do
  grep -qxF ".$path" <<<"$payload" || fail "$pkg does not install $path"
done
echo "$pkg"
