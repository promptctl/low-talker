#!/usr/bin/env python3
"""Writes the SBOM of what a release ships, read off the resolved build.

    scripts/sbom <model-tool> <output.cdx.json> [model store]

CycloneDX 1.6, one component per thing that reaches a user's Mac: every package
Package.resolved pins, the third-party code vendored inside those packages, and the model
the app loads (its weights and its tokenizer). Identity, URL, version and revision come
from Package.resolved, the checkouts under .build, and model-tool; sbom/rules.json holds
only what none of those can say - the license of each component, which packages carry
code no manifest declares, and which Hugging Face repos the default model's two parts come
from. [LAW:one-source-of-truth]

A component the rules do not know stops the run and names it, because a row missing from
an SBOM is believed. [LAW:no-silent-failure] The output carries no timestamp and no
serial number, so the same checkout writes the same bytes twice.

The model's repos are the one thing here a clean checkout cannot check, since WhisperKit
picks the tokenizer's repo off the weights' config once they are downloaded. So when a
store holding the model is named, the rules are held to the folders its install
manifests record, and a rule naming a repo the install did not fetch from stops the run.
The store changes nothing in the output; it only refuses a wrong rule.

Run through `make sbom`, which builds model-tool first, names it, and names this Mac's store
when it has one.
"""
import hashlib
import itertools
import json
import re
import subprocess
import sys
from pathlib import Path

repository = Path(__file__).resolve().parent.parent
rules_path = repository / "sbom" / "rules.json"
checkouts = repository / ".build" / "checkouts"


def fail(message):
    print(f"sbom: {message}", file=sys.stderr)
    sys.exit(1)


def run(tool, arguments, what):
    """A tool's stdout, or a failure naming the tool and what it said: a traceback would
    name a Python line where the reader needs the component."""
    try:
        return subprocess.run([tool] + arguments, cwd=repository, capture_output=True, text=True, check=True).stdout
    except FileNotFoundError:
        fail(f"{what}: {tool} is not installed")
    except subprocess.CalledProcessError as error:
        fail(f"{what}: `{tool} {' '.join(arguments)}` exited {error.returncode}: {error.stderr.strip()}")


def need(rule, key, component):
    if not rule.get(key):
        fail(f"{component}: rules.json gives no `{key}`")
    return rule[key]


def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def license_entry(component, root, rule):
    """The license id and its text, and the file under `root` the text was read from with
    that file's digest, so the SBOM says which text the reading was of. `root` is the package
    checkout, as for every other path property here, or this repository for a model. The
    text is what the notices the app carries are generated from. [LAW:one-source-of-truth]"""
    spdx = need(rule, "license", component)
    relative = need(rule, "licenseFile", component)
    path = root / relative
    if not path.is_file():
        fail(f"{component}: license file {relative} is not in {root}")
    try:
        text = path.read_text()
    except UnicodeDecodeError as error:
        fail(f"{component}: license file {relative} is not UTF-8 text ({error})")
    if "licenseMatch" in rule:
        found = re.search(rule["licenseMatch"], text, re.MULTILINE | re.DOTALL)
        if not found:
            fail(f"{component}: {relative} does not match {rule['licenseMatch']!r}, so its license text cannot be read")
        text = found.group(1)
    properties = [
        {"name": "low-talker:license-file", "value": relative},
        {"name": "low-talker:license-file-sha256", "value": sha256(path)},
    ]
    # An id with no template here is one check-licenses refuses, and the refusal, with what
    # to do about it, is that gate's to give. [LAW:single-enforcer]
    template = license_templates.get(spdx.casefold())
    if template is not None:
        # SPDX ids match without regard to case; the SBOM spells the id as the List does.
        spdx, pattern = template
        if not pattern.search(comparable(text)):
            fail(f"{component}: {relative} does not carry the text of {spdx} as the SPDX License List "
                 f"{SPDX_LICENSE_LIST} template reads it, so the rule names a license the file does not state")
        properties.append({"name": "low-talker:license-text", "value": f"SPDX License List {SPDX_LICENSE_LIST} {spdx} template"})
    return (
        [{"license": {"id": spdx, "text": {"contentType": "text/plain", "content": text.lstrip("\n").rstrip() + "\n"}}}],
        properties,
    )


# The SPDX License List release sbom/spdx holds, named by its one directory: the template of
# each license check-licenses accepts, byte for byte from license-list-data's template/, and
# the words SPDX matches as one, from license-list-XML's equivalentwords.txt, at that tag.
releases = sorted(path.name for path in (repository / "sbom" / "spdx").iterdir() if path.is_dir())
if len(releases) != 1:
    fail(f"sbom/spdx holds {releases or 'no release'}, and the templates are one SPDX License List release")
[SPDX_LICENSE_LIST] = releases
license_list = repository / "sbom" / "spdx" / SPDX_LICENSE_LIST

# The template markup: optional text, and a var, which is a span the template's own regular
# expression matches. A var's fields are quoted, and its `original` can hold a `>`.
TEMPLATE_MARKUP = re.compile(r'<<(beginOptional|endOptional|var(?:;[a-z]+="(?:[^"\\]|\\.)*")*)>>')
VAR_MATCH = re.compile(r'match="((?:[^"\\]|\\.)*)"')
# Whatever whitespace and punctuation stand between two words, or none, as before a var whose
# own expression opens with a space. A word stands whole, so two never run together.
BETWEEN_WORDS = r"[\W_]*"
COPYRIGHT_SYMBOL = re.compile(r"©|\(c\)", re.IGNORECASE)
# The punctuation at either edge of a line: a comment's markers, in whatever syntax wraps the
# license, and a box's borders. Inside a var only whitespace may stand between its words.
LINE_EDGE = re.compile(r"^(?:(?!\n)[\W_])+|(?:(?!\n)[\W_])+$", re.MULTILINE)


def spelled(form):
    """A form of an equivalent word as a pattern: its words, each whole, with anything between
    them but nothing; or a form with no words, as `&` is, as itself."""
    found = r"[\W_]+".join(map(re.escape, re.findall(r"[^\W_]+", form)))
    return rf"(?<![^\W_]){found}(?![^\W_])" if found else re.escape(form)


def equivalent_words(listing):
    """Each line's later forms, as patterns, with the form to read them as: the line's first,
    or what that is read as where an earlier line lists it. A form whose words are its first
    form's, as `sub license` beside `sub-license`, already reads the same."""
    read_as = {}
    for line in listing.splitlines():
        first, *others = line.split(",")
        for form in others:
            if spelled(form) != spelled(first):
                read_as[spelled(form)] = read_as.get(spelled(first), first)
    return [(re.compile(pattern, re.IGNORECASE), f" {first} ") for pattern, first in read_as.items()]


EQUIVALENT_WORDS = equivalent_words((license_list / "equivalentwords.txt").read_text())


def equivalent(text):
    """The text with each varietal spelling read as the one SPDX lists first. The spaces around
    it keep `&` from joining the words beside it."""
    for form, first in EQUIVALENT_WORDS:
        text = form.sub(lambda _: first, text)
    return text


def words(literal):
    return [("word", word) for word in re.findall(r"[^\W_]+", equivalent(COPYRIGHT_SYMBOL.sub(" ", literal)))]


def template_parts(template):
    """The template as its parts, in order: a word, a var's expression, or an optional run of
    parts."""
    nested = [[]]
    position = 0
    for mark in TEMPLATE_MARKUP.finditer(template):
        nested[-1] += words(template[position:mark.start()])
        tag = mark.group(1)
        if tag == "beginOptional":
            nested.append([])
        elif tag == "endOptional":
            optional = nested.pop()
            nested[-1].append(("optional", optional))
        else:
            nested[-1].append(("var", VAR_MATCH.search(tag).group(1)))
        position = mark.end()
    nested[-1] += words(template[position:])
    return nested[0]


def whole(word):
    return rf"(?<![^\W_]){re.escape(word)}(?![^\W_])"


# A regular expression's atoms, enough to tell a var's any-character `.` from an escaped one
# or one inside a character class.
EXPRESSION_ATOM = re.compile(r"\\.|\[(?:\\.|[^\]\\])*\]|.", re.DOTALL)


def expressions(parts, after, names):
    """Each part as an expression. A var that can run over any text runs as SPDX's does, to
    the next word the template requires after it (`after` where nothing in `parts` is), and
    is read once where that word is the next part required: its any-character stops short of
    the word, and the lookahead it is read in gives nothing back. Without both, a near miss is
    retried at every split of every such var and of the punctuation beside it, which grows
    with the power of their number, and a `.+` reaches across any license spliced inside it.
    A var the next var follows keeps its splits, since where it ends is that var's to say.
    `names` numbers each var read once."""
    out = []
    for index, (kind, value) in enumerate(parts):
        following = next((whole(word) for k, word in parts[index + 1:] if k == "word"), after)
        required = next((k for k, _ in parts[index + 1:] if k != "optional"), "word")
        if kind == "word":
            out.append(whole(value))
        elif kind == "optional":
            out.append(f"(?:{BETWEEN_WORDS.join(expressions(value, following, names))})?")
        elif "." not in EXPRESSION_ATOM.findall(value):
            out.append(f"(?:{value})")
        else:
            held = "".join(f"(?:(?!{following}).)" if atom == "." and following else atom
                           for atom in EXPRESSION_ATOM.findall(value))
            if required == "word":
                name = f"var{next(names)}"
                out.append(f"(?=(?P<{name}>{held}))(?P={name})")
            else:
                out.append(f"(?:{held})")
    return out


def template_pattern(template):
    """An SPDX template as one regular expression, compared as SPDX's License Matching
    Guidelines compare: the words, and not their case, their varietal spellings, the
    whitespace and punctuation between them, or which of ©, (c) and none the copyright line
    uses. A search, not a full match: a license file may carry more than the license, as a
    NOTICES file's preamble or an exception appended to Apache-2.0 do."""
    # A part at either end that can match nothing changes nothing a search finds, so it is
    # left off: a leading copyright var's `.{0,5000}` would otherwise be retried at every
    # character of the file, which is most of a minute to refuse a 485 KB header.
    held = expressions(template_parts(template), None, itertools.count())
    while re.fullmatch(held[0], ""):
        held.pop(0)
    while re.fullmatch(held[-1], ""):
        held.pop()
    return re.compile(BETWEEN_WORDS.join(held), re.IGNORECASE)


def comparable(text):
    """A license text as a template's pattern reads it: without the punctuation at the edges
    of its lines, which source files wrap a license in, its words spelled as the template's
    are, and its whitespace one space wherever it stands, since a var's own expression can
    name a single space."""
    return re.sub(r"\s+", " ", LINE_EDGE.sub("", equivalent(COPYRIGHT_SYMBOL.sub(" ", text))))


# Each template, by its id without regard to case: the id as the List spells it, and its pattern.
license_templates = {
    spdx.casefold(): (spdx, template_pattern(path.read_text()))
    for path in license_list.glob("*.template.txt")
    for spdx in [path.name.removesuffix(".template.txt")]
}


def license_texts_held(components):
    """How many components, the vendored ones included, had their license text held to their
    id, and how many components there are."""
    every = components + [vendored for c in components for vendored in c.get("components", [])]
    return sum(p["name"] == "low-talker:license-text" for c in every for p in c["properties"]), len(every)


def vendored_version(component, checkout, rule):
    """The version written into the vendored files, by the rule's expression: group 1 is
    the version, group 2 the revision when the files carry one, unless `as` composes it."""
    relative = need(rule, "file", component)
    pattern = need(rule, "match", component)
    source = checkout / relative
    if not source.is_file():
        fail(f"{component}: version file {relative} is not in the checkout")
    found = re.search(pattern, source.read_text(errors="replace"), re.MULTILINE)
    if not found:
        fail(f"{component}: {relative} does not match {pattern!r}, so its version cannot be read")
    if "as" in rule:
        def group(reference):
            number = int(reference.group(1))
            if number > found.re.groups or found.group(number) is None:
                fail(f"{component}: `as` {rule['as']!r} names ${number}, which {pattern!r} did not capture in {relative}")
            return found.group(number)
        return re.sub(r"\$(\d+)", group, rule["as"]), None
    return found.group(1), found.group(2) if found.re.groups >= 2 else None


# Every key a package's rule is read with. Any other is a misspelling of one of these, and a
# misspelt `vendored` would leave the code it names out of the SBOM without a word.
# [LAW:no-silent-failure]
PACKAGE_KEYS = {"license", "licenseFile", "licenseMatch", "vendored"}


def package_component(pin, rule):
    identity = pin["identity"]
    if unknown := sorted(set(rule) - PACKAGE_KEYS):
        fail(f"{identity}: rules.json gives {unknown}, which no rule is read with; the keys are {sorted(PACKAGE_KEYS)}")
    location = pin["location"]
    repo = location.rsplit("/", 1)[-1].removesuffix(".git")
    checkout = checkouts / repo
    if not checkout.is_dir():
        fail(f"{identity}: no checkout at {checkout.relative_to(repository)}; run `swift build`")
    state = pin["state"]
    version = state.get("version")
    if not version:
        fail(f"{identity}: Package.resolved pins it by revision alone, with no version")
    ref = f"pkg:swift/{re.sub(r'^https?://', '', location).removesuffix('.git')}@{version}"
    licenses, properties = license_entry(identity, checkout, rule)
    component = {
        "type": "library",
        "bom-ref": ref,
        "name": repo,
        "version": version,
        "purl": ref,
        "licenses": licenses,
        "externalReferences": [{"type": "vcs", "url": location}],
        "properties": [{"name": "low-talker:revision", "value": state["revision"]}] + properties,
    }
    vendored = [vendored_component(identity, checkout, v) for v in rule.get("vendored", [])]
    if vendored:
        component["components"] = sorted(vendored, key=lambda c: c["bom-ref"])
    return component


def vendored_component(identity, checkout, rule):
    vendored = need(rule, "name", f"a component {identity} vendors")
    name = f"{identity} vendors {vendored}"
    relative = need(rule, "path", name)
    if not (checkout / relative).exists():
        fail(f"{name}: nothing at {relative} in the checkout")
    version, revision = vendored_version(name, checkout, need(rule, "version", name))
    origin = need(rule, "origin", name)
    found = re.fullmatch(r"https://github\.com/([^/]+/[^/]+?)(?:\.git)?", origin)
    if not found:
        fail(f"{name}: origin {origin!r} is not a https://github.com/<owner>/<repo> URL, so it has no purl")
    ref = f"pkg:github/{found.group(1)}@{version}"
    licenses, properties = license_entry(name, checkout, rule)
    properties = [{"name": "low-talker:vendored-at", "value": relative}] + properties
    if revision:
        properties.insert(0, {"name": "low-talker:revision", "value": revision})
    return {
        "type": "library",
        "bom-ref": ref,
        "name": vendored,
        "version": version,
        "purl": ref,
        "licenses": licenses,
        "externalReferences": [{"type": "vcs", "url": origin}],
        "properties": properties,
    }


def model_components(tool, rules, store):
    """The model model-tool names as the default, which is the one the release carries and
    a launch loads where nothing names another. WhisperKit fetches its weights from the
    repo it names and picks the tokenizer's repo off the weights' config, so both repos
    are the rule's to state and the store's, when there is one, to confirm."""
    if not tool.is_file():
        fail(f"no model tool at {tool}; run `make model-tool`")
    model = run(str(tool), ["default"], "the default model").strip()
    if not model:
        fail("`model-tool default` printed nothing")
    rule = rules.get(model)
    if rule is None:
        fail(f"the default model is {model} and rules.json has no entry for it")
    components = []
    confirmed = []
    for part, kind in (("weights", "machine-learning-model"), ("tokenizer", "data")):
        component = f"{model} {part}"
        entry = need(rule, part, component)
        repo = need(entry, "repo", component)
        if repo.count("/") != 1:
            fail(f"{component}: rules.json names the repo {repo!r}, not <owner>/<repo>")
        licenses, properties = license_entry(component, repository, entry)
        if store is not None and confirm_against_store(store, model, part, repo):
            confirmed.append(part)
        # The weights are one folder of a repo holding many models, so the repo is their
        # group and the model their name; the tokenizer is a repo of its own.
        group, name = (repo, model) if part == "weights" else repo.split("/", 1)
        entry = {
            "type": kind,
            "bom-ref": f"huggingface.co/{repo}" + (f"/{model}" if part == "weights" else ""),
            "group": group,
            "name": name,
            "licenses": licenses,
            "externalReferences": [{"type": "distribution", "url": f"https://huggingface.co/{repo}"}],
            "properties": [{"name": "low-talker:model-part", "value": part}] + properties,
        }
        if part == "weights":
            entry["description"] = f"The folder of {repo} whose name ends in {model}, which is how WhisperKit picks it"
        components.append(entry)
    return components, confirmed


def confirm_against_store(store, model, part, repo):
    """Holds a rule's repo to the folder the install wrote, as its manifest records it:
    `models/<owner>/<repo>[/<folder>]`. A store with no manifest for this part has not
    installed it - another model's store, or a download that stopped - and so has nothing
    to hold the rule to; only a manifest that disagrees is a failure. Answers whether the
    rule was confirmed."""
    manifest = store / "installed" / (f"tokenizer/{model}.json" if part == "tokenizer" else f"{model}.json")
    if not manifest.is_file():
        return False
    try:
        folder = json.loads(manifest.read_text()).get("folder", "")
    except (OSError, ValueError) as error:
        fail(f"{model} {part}: manifest {manifest} cannot be read ({error}); reinstall the model into {store}")
    parts = folder.split("/")
    if len(parts) < 3 or parts[0] != "models":
        fail(f"{model} {part}: manifest {manifest} records folder {folder!r}, not a models/<owner>/<repo> path")
    installed = f"{parts[1]}/{parts[2]}"
    if installed != repo:
        fail(f"{model} {part}: rules.json says {repo}, and the install in {store} came from {installed} ({folder})")
    if part == "weights" and not folder.endswith(model):
        fail(f"{model} weights: the install in {store} is {folder}, which is not a folder for {model}")
    return True


def application():
    settings = json.loads(run("xcodegen", ["dump", "--type", "json"], "the app's version")).get("settings", {}).get("base", {})
    version = settings.get("MARKETING_VERSION")
    if not version:
        fail("project.yml sets no project-wide MARKETING_VERSION")
    return {"type": "application", "bom-ref": "lowtalker", "name": "LowTalker", "version": str(version)}


def main():
    if len(sys.argv) not in (3, 4):
        fail("usage: scripts/sbom <model-tool> <output.cdx.json> [model store]")
    tool = Path(sys.argv[1]).resolve()
    output = Path(sys.argv[2])
    store = Path(sys.argv[3]) if len(sys.argv) == 4 else None
    if store is not None and not store.is_dir():
        fail(f"{store} is not a directory")
    rules = json.loads(rules_path.read_text())
    pins = json.loads((repository / "Package.resolved").read_text())["pins"]

    pinned = {pin["identity"] for pin in pins}
    ruled = set(rules["packages"])
    if pinned - ruled:
        fail(f"Package.resolved pins {', '.join(sorted(pinned - ruled))}, and sbom/rules.json has no entry for "
             f"{'it' if len(pinned - ruled) == 1 else 'them'}: the license has not been read")
    if ruled - pinned:
        fail(f"sbom/rules.json has an entry for {', '.join(sorted(ruled - pinned))}, which Package.resolved no longer pins")

    components = [package_component(pin, rules["packages"][pin["identity"]]) for pin in pins]
    models, confirmed = model_components(tool, rules["models"], store)
    components += models
    components.sort(key=lambda c: c["bom-ref"])
    app = application()
    bom = {
        "bomFormat": "CycloneDX",
        "specVersion": "1.6",
        "version": 1,
        "metadata": {"component": app},
        "components": components,
        "dependencies": [{"ref": app["bom-ref"], "dependsOn": [c["bom-ref"] for c in components]}],
    }
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(bom, indent=2, sort_keys=True) + "\n")
    if store is None:
        held = ""
    elif confirmed:
        held = f"; the {' and '.join(confirmed)} rules held to the install in {store}"
    else:
        held = f"; {store} holds no install of the default model, so its rules were not confirmed"
    texts, every = license_texts_held(components)
    print(f"{output}: {len(components)} components, {every - len(components)} vendored, "
          f"{texts} of {every} license texts held to their ids{held}")


if __name__ == "__main__":
    main()
