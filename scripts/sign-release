#!/usr/bin/env bash
# Builds the LowTalker installer packages to hand to someone else, one per variant, offline and
# network, and proves the signature on everything each installs is one the notary service
# accepts: the app and the input method bundle beside it.
#
#   scripts/sign-release <output directory> [model source]
#     # prints <output directory>/LowTalker-offline.pkg and <output directory>/LowTalker-network.pkg
#
# The bundle carries the default model in Contents/Resources/model-store, so a first launch
# loads it in place with the network off. The model source is what `model-tool download
# --from` takes: a store holding the model, such as ~/Library/Application Support/low-talker/hub,
# or a base URL serving the archive `model-tool pack` writes. With none, the model comes
# from Hugging Face.
#
# The build is `make package` signed with the Developer ID identity in place of the
# development one, once per variant, and the identity and the variant are all this script
# changes about the build: the Hardened Runtime, the secure timestamp and the entitlements are
# project.yml's for every build, so the offline bundle a person develops on is built exactly
# as the offline one here is. It goes into a derived-data directory made for this run and
# removed after it, so a release is always a clean build.
#
# [LAW:one-source-of-truth] The recipe is the Makefile's; this script only names the
# certificate and reads the result back. The certificate is named in full, team and all: the
# team is what the checks below hold every signature to, and it is read off the name
# scripts/developer-id holds rather than written a second time. project.yml sets no
# DEVELOPMENT_TEAM, since Xcode takes one as a filter that the self-signed development
# identity cannot pass.
set -euo pipefail

source "$(dirname "$0")/developer-id"
identity="Developer ID Application: $developer_id"
team=${identity##*(}
team=${team%)}

out=${1:?usage: scripts/sign-release <output directory> [model source]}
source=${2:-}
# Made and resolved before the move to the repo root, which make and xcodegen need, so a
# relative directory means the one the caller named.
mkdir -p "$out"
out=$(cd "$out" && pwd)
if [ -d "$source" ]; then source=$(cd "$source" && pwd); fi
cd "$(dirname "$0")/.."

derived=$(mktemp -d "${TMPDIR:-/tmp}/lowtalker-release.XXXXXX")
trap 'rm -rf "$derived"' EXIT

# The model tool decides which model is the default and installs it whole, manifests and all, so
# this script names neither. [LAW:one-source-of-truth] It fetches once here; `make package`
# then copies the store the bundle carries out of the fetched one by the same rule every
# build uses, so what the bundle carries is exactly what an install certifies.
tool=$(make model-tool | tee /dev/stderr | tail -n 1)
fetched="$derived/fetched-store"
"$tool" download --models-dir "$fetched" ${source:+--from "$source"} >&2
# The SBOM's model rules held to the store this release carries, not to whichever store
# the Mac that last ran `make sbom` had, the committed SBOM held to this checkout, and every
# component in it held to the accepted licenses: this release is the distribution.
make check-licenses MODEL_SOURCE="$fetched" >&2

fail() {
  echo "sign-release: $1" >&2
  exit 1
}

# What the notary service refuses, asked of one binary: no Developer ID signature from the
# team, no Hardened Runtime, or no secure timestamp. The get-task-allow entitlement it also
# refuses is scripts/variant's, which make-pkg ran first and which refuses every key it does
# not name. [LAW:single-enforcer]
check() {
  local binary=$1 signature
  signature=$(codesign -dvv "$binary" 2>&1)
  grep -qx "Authority=Developer ID Application: .* ($team)" <<<"$signature" \
    || fail "$binary is not signed with a Developer ID Application certificate for team $team"
  grep -qE '^CodeDirectory .*flags=0x[0-9a-f]+\([^)]*runtime' <<<"$signature" \
    || fail "$binary is not signed with Hardened Runtime"
  grep -q '^Timestamp=' <<<"$signature" \
    || fail "$binary has no secure timestamp"
}

resources=$(xcodegen dump --type json | jq -er '.targets.LowTalker.settings.base')
store=$(jq -er '.MODEL_STORE_RESOURCE // error("project.yml names no MODEL_STORE_RESOURCE")' <<<"$resources")
products="$derived/Build/Products/Release"
app="$products/LowTalker.app"

# One variant built, checked and copied out before the next is built over it in the same
# derived data, which rebuilds only the app's signature.
release_package() {
  local variant=$1 built bundle method methods
  built=$(make package VARIANT="$variant" SIGNING_IDENTITY="$identity" DERIVED_DATA="$derived" MODEL_SOURCE="$fetched" | tee /dev/stderr | tail -n 1)
  codesign --verify --deep --strict "$app" || fail "$app does not verify"
  "$tool" status --models-dir "$app/Contents/Resources/$store" >&2 \
    || fail "$app does not carry the default model whole"
  check "$app"
  # The input method bundle the package installs beside the app. The notary service refuses
  # the whole upload for one nested bundle it dislikes, long after this script has printed the
  # path as success.
  #
  # The bundle is asked, and its main executable is not, because they answer with one
  # signature: `codesign -dvv` on `X.app/Contents/MacOS/X` resolves the path back to the
  # bundle and prints byte-for-byte what `codesign -dvv X.app` prints - measured. A second
  # `check` there is a second checkpoint for one rule that can never disagree with the first.
  # [LAW:single-enforcer]
  #
  # Found by looking rather than by name: the bundle is called after PRODUCT_NAME, which is
  # project.yml's to decide, and a name spelled here is one more copy to keep in step. The
  # derived data is this run's own, so every bundle in it besides the app is an input method
  # built with it. A build with none is a release whose delivery does not exist, so it fails
  # rather than passing a loop that ran zero times. [LAW:no-silent-failure]
  methods=()
  for bundle in "$products"/*.app; do
    [ "$bundle" = "$app" ] || methods+=("$bundle")
  done
  [ ${#methods[@]} -gt 0 ] || fail "$products holds no input method bundle beside $app"
  for method in "${methods[@]}"; do
    check "$method"
  done
  # make-pkg names the package after the variant it reads off the app's signature, so this is
  # where a build whose entitlements did not follow VARIANT stops, rather than shipping as a
  # second copy of the other variant.
  [ "$(basename "$built")" = "LowTalker-$variant.pkg" ] \
    || fail "the $variant build packed as $(basename "$built"), so its entitlements are not the $variant build's"
  cp -f "$built" "$out/"
  echo "$out/$(basename "$built")"
}

# Every variant the Makefile builds, each a package of its own: offline and network. Read
# into a variable first, since a failed command in a for list is a loop that runs zero times.
variants=$(make --no-print-directory -s variants)
[ -n "$variants" ] || fail "make variants names no variant to build"
for variant in $variants; do
  release_package "$variant"
done
